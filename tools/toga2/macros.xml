<?xml version="1.0"?>
<macros>
    <token name="@TOOL_VERSION@">2.0.8</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">26.0</token>

    <!--
        CONTAINER-ONLY tool (NOT on bioconda). TOGA2 ships as a large
        container (anaconda3 base + tensorflow + rust + nextflow + CESAR2)
        that runs Nextflow over real genome alignments.

        The upstream hillerlab/TOGA2 repo ships ONLY an apptainer/Singularity
        def (supply/containers/apptainer.def); there is no published Docker
        image, no bioconda package and no biocontainer, so this tool cannot
        resolve through conda like the rest of this repo.

        We build a SIF from the upstream def, pinned to the v2.0.8 tag that the
        wrapper's CLI mapping and output schema were verified against (upstream
        main is already past v2.0.9; re-verify before moving the pin), and
        place it on shared storage so every compute node sees one copy:

            apptainer build toga2-2.0.8.sif tools/toga2/toga2-2.0.8.def

        That def is in this directory. It is upstream's with the clone pinned
        to the v2.0.8 tag and apt forced to IPv4; see its header for why.

        Deployments that keep the image elsewhere only need to override this
        token. Replace with a digest-pinned `docker://` reference once an
        upstream image is published.
    -->
    <token name="@TOGA_IMAGE@">/data/containers/toga2-2.0.8.sif</token>

    <xml name="requirements">
        <requirements>
            <container type="singularity">@TOGA_IMAGE@</container>
        </requirements>
    </xml>

